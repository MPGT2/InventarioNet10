@{
    ViewData["Title"] = "Inicio";
    var ultimos = ViewBag.Ultimos as List<InventarioNet10.Models.Producto> ?? new List<InventarioNet10.Models.Producto>();
}

<section class="hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge text-bg-light mb-3">ASP.NET Core MVC · .NET 10 · SQL Server</span>
            <h1 class="display-5 fw-bold mb-2">InventarioNet10</h1>
            <p class="lead mb-4">Sistema de gestión de productos con operaciones CRUD, listo para desplegar en IIS, AWS y hosting compartido.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Productos" asp-action="Index" class="btn btn-light btn-lg text-primary fw-semibold">Ver productos</a>
                <a asp-controller="Productos" asp-action="Create" class="btn btn-outline-light btn-lg">Registrar producto</a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <div class="hero-icon">📦</div>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card stat-blue h-100">
            <div class="card-body">
                <div class="stat-label">Productos</div>
                <div class="stat-value">@ViewBag.TotalProductos</div>
                <div class="small opacity-75">registros en la base de datos</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-green h-100">
            <div class="card-body">
                <div class="stat-label">Stock total</div>
                <div class="stat-value">@ViewBag.TotalStock</div>
                <div class="small opacity-75">unidades disponibles</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-amber h-100">
            <div class="card-body">
                <div class="stat-label">Categorías</div>
                <div class="stat-value">@ViewBag.TotalCategorias</div>
                <div class="small opacity-75">grupos de productos</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Últimos productos registrados</span>
                <a asp-controller="Productos" asp-action="Index" class="small">Ver todos</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ultimos)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Nombre</td>
                                <td><span class="badge rounded-pill text-bg-light border">@p.Categoria</span></td>
                                <td class="text-end">$@p.Precio.ToString("N2")</td>
                                <td class="text-center">@p.Stock</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Operaciones disponibles</h2>
                <p class="text-muted">El CRUD cubre las cuatro operaciones básicas sobre la tabla <code>Productos</code>.</p>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><span class="badge text-bg-primary me-2">C</span> Crear un producto nuevo.</li>
                    <li class="mb-2"><span class="badge text-bg-success me-2">R</span> Leer y filtrar el inventario.</li>
                    <li class="mb-2"><span class="badge text-bg-warning me-2">U</span> Actualizar precio, stock o categoría.</li>
                    <li><span class="badge text-bg-danger me-2">D</span> Eliminar un registro.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
