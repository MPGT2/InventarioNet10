<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InventarioNet10</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        html { font-size: 14px; position: relative; min-height: 100%; }
        body { margin-bottom: 60px; background: #f4f6fb; color: #1f2937; font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
        .app-navbar { background: linear-gradient(90deg, #0b2a5b 0%, #0f4c9c 60%, #1565c0 100%); box-shadow: 0 2px 12px rgba(11, 42, 91, 0.25); }
        .app-navbar .nav-link { color: rgba(255, 255, 255, 0.85); }
        .app-navbar .nav-link:hover, .app-navbar .nav-link:focus { color: #ffffff; }
        .app-navbar .navbar-text { color: rgba(255, 255, 255, 0.7); }
        .brand-mark { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 9px; background: #ffffff; color: #0f4c9c; font-size: 0.8rem; font-weight: 800; margin-right: 6px; }
        .hero { background: linear-gradient(120deg, #0b2a5b 0%, #0f4c9c 55%, #1976d2 100%); color: #ffffff; border-radius: 18px; padding: 2.5rem; box-shadow: 0 14px 34px rgba(15, 76, 156, 0.25); }
        .hero .lead { color: rgba(255, 255, 255, 0.82); max-width: 640px; }
        .hero-icon { font-size: 7rem; line-height: 1; filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.25)); }
        .stat-card { border: 0; border-radius: 14px; color: #ffffff; box-shadow: 0 8px 20px rgba(31, 41, 55, 0.12); }
        .stat-card .stat-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85; }
        .stat-card .stat-value { font-size: 2rem; font-weight: 700; line-height: 1.2; }
        .stat-blue { background: linear-gradient(135deg, #0f4c9c, #1976d2); }
        .stat-green { background: linear-gradient(135deg, #146c43, #1f9d63); }
        .stat-amber { background: linear-gradient(135deg, #b45309, #f59e0b); }
        .card { border-radius: 14px; }
        .card-header { border-top-left-radius: 14px !important; border-top-right-radius: 14px !important; }
        .table > :not(caption) > * > * { padding-top: 0.8rem; padding-bottom: 0.8rem; }
        .footer { background: #ffffff; border-top: 1px solid #e5e7eb; color: #6b7280; }
        .btn-primary { background-color: #0f4c9c; border-color: #0f4c9c; }
        .btn-primary:hover, .btn-primary:focus { background-color: #0b3a78; border-color: #0b3a78; }
        .btn-outline-primary { color: #0f4c9c; border-color: #0f4c9c; }
        .btn-outline-primary:hover { background-color: #0f4c9c; border-color: #0f4c9c; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">IN</span> InventarioNet10
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Productos" asp-action="Create">Nuevo producto</a>
                        </li>
                    </ul>
                    <span class="navbar-text small d-none d-md-inline">CRUD · .NET 10 · SQL Server</span>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-5 py-3">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small">
            <span>© 2026 InventarioNet10 — Práctica de Servicios de Red</span>
            <span>Despliegue multi-entorno: IIS · AWS · Hosting compartido</span>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
