@model InventarioNet10.Models.Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Eliminar producto</h1>
        <p class="text-muted mb-0">Confirmar la eliminación del registro #@Model.Id</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger mb-4">
            Esta acción elimina el producto de forma permanente. ¿Deseás continuar?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Nombre</dd>

            <dt class="col-sm-3">Categoría</dt>
            <dd class="col-sm-9">@Model.Categoria</dd>

            <dt class="col-sm-3">Precio</dt>
            <dd class="col-sm-9">$@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9 mb-0">@Model.Stock unidades</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
