@model IEnumerable<InventarioNet10.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var categoriaActual = ViewBag.Categoria as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Inventario de productos</h1>
        <p class="text-muted mb-0">CRUD completo sobre SQL Server</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">+ Nuevo producto</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card stat-blue h-100">
            <div class="card-body">
                <div class="stat-label">Productos registrados</div>
                <div class="stat-value">@ViewBag.TotalProductos</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-green h-100">
            <div class="card-body">
                <div class="stat-label">Unidades en stock</div>
                <div class="stat-value">@ViewBag.TotalStock</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card stat-amber h-100">
            <div class="card-body">
                <div class="stat-label">Valor del inventario</div>
                <div class="stat-value">$@(((decimal)ViewBag.ValorInventario).ToString("N2"))</div>
            </div>
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="buscar">Buscar por nombre o categoría</label>
            <input id="buscar" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej. laptop, monitor, red..." />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="categoria">Filtrar por categoría</label>
            <select id="categoria" name="categoria" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c" selected="@(categoriaActual == c)">@c</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th>Registro</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            No se encontraron productos con ese filtro.
                        </td>
                    </tr>
                }
                @foreach (var producto in Model)
                {
                    <tr>
                        <td class="text-muted">@producto.Id</td>
                        <td class="fw-semibold">@producto.Nombre</td>
                        <td><span class="badge rounded-pill text-bg-light border">@producto.Categoria</span></td>
                        <td class="text-end">$@producto.Precio.ToString("N2")</td>
                        <td class="text-center">
                            @if (producto.Stock == 0)
                            {
                                <span class="badge text-bg-danger">Agotado</span>
                            }
                            else if (producto.Stock < 10)
                            {
                                <span class="badge text-bg-warning">@producto.Stock</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">@producto.Stock</span>
                            }
                        </td>
                        <td class="text-muted small">@producto.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
